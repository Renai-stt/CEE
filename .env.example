# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model alias to use for OCR extraction (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# MONGO_URI: MongoDB connection string (e.g., mongodb://localhost:27017/receipt_tracker or Atlas URI)
# If omitted or offline, the app automatically runs resilient local persistence in dev mode.
MONGO_URI="mongodb://localhost:27017/receipt_tracker"

# JWT Secrets for authentication cookies
JWT_SECRET="super-secret-jwt-key-replace-in-production-min32chars"
JWT_REFRESH_SECRET="super-secret-refresh-jwt-key-replace-in-production"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port
PORT=3000

# NODE_ENV
NODE_ENV="development"
